apiVersion: v1
kind: Service
metadata:
  labels:
    app: __OCBuildName__
    environment: __environment__
  name: eam-integration-extended
  namespace: __OCProjectName__
spec:
  ports:
    - name: 8200-tcp
      port: 8200
      protocol: TCP
      targetPort: 8200
  selector:
    app: __OCBuildName__
  sessionAffinity: None
  type: ClusterIP
status:
  loadBalancer: {}