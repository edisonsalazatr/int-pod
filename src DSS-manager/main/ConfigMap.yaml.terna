                    "entityType": "TOPIC",
                    "entityDescription": "Kafka topic per l'invio odl a Geocall",
                    "entityObjectName": "send message OdL",
                    "entityObjectClass": "it.terna.nas.service.material.dto.workorder.WorkOrderDTO",
                    "entityUuidMethodName": "getWonum"
                },
                "integrationSendSapStornoTotaleMessage": {
                    "entityName": "eam-hours-transfer-sap-t__kafkaTopicSuffix__",
                    "entityType": "TOPIC",
                    "entityDescription": "Kafka topic per l'invio Storno Totale a Sap",
                    "entityObjectName": "send message OdL",
                    "entityObjectClass": "it.terna.nas.service.material.dto.workorder.WorkOrderDTO",
                    "entityUuidMethodName": "getWonum",
                    "entityNumberOfPartition": "3",
                    "entityNumberOfReplicas": "3"
                },
                "integrationSendCaviMessage": {
                    "entityName": "eam-invio-odl-cavi-interrati__kafkaTopicSuffix__",
                    "entityType": "TOPIC",
                    "entityDescription": "Kafka topic per l'invio OdL a Cavi",
                    "entityObjectName": "send message OdL",
                    "entityObjectClass": "it.terna.nas.service.material.dto.workorder.WorkOrderDTO",
                    "entityUuidMethodName": "getWonum"
                },
                "integrationSendCaviDeleteMessage": {
                    "entityName": "eam-invio-odl-delete-cavi-interrati__kafkaTopicSuffix__",
                    "entityType": "TOPIC",
                    "entityDescription": "Kafka topic per l'invio OdL a Cavi",
                    "entityObjectName": "send message OdL",
                    "entityObjectClass": "it.terna.nas.service.material.dto.workorder.WorkOrderDTO",
                    "entityUuidMethodName": "getWonum",
                    "entityNumberOfPartition": "3",
                    "entityNumberOfReplicas": "3"
                },
                "dssForwardOdLHandlerManager": {
                    "entityName": "topic-mas-handle-forward-odl-event__kafkaTopicSuffix__",
                    "entityType": "TOPIC",
                    "entityDescription": "Kafka topic create or change Asset",
                    "entityObjectName": "Create or change Asset",
