apiVersion: v1
kind: Secret
data:
  osb-basicauth-username: __osb-eam-username__
  osb-basicauth-password: __osb-eam-password__
  eam-client-id: __eam-client-id__
  eam-client-secret: __eam-client-secret__
  eam-integration-keystore.jks: __eam-integration-keystore__
  eam-ca-certificate.jks: __eam-ca-certificate__
  eam-database-username: __eam-database-username__
  eam-database-password: __eam-database-password__
  servicenow-apikey: __servicenow-apikey__
  maximo-apikey: __maximo-apikey__
metadata:
  name: eam-integration-extended-secret-credentials
  namespace: __OCProjectName__
type: Opaque
