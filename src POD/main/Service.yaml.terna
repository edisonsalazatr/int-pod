apiVersion: v1
kind: Service
metadata:
  labels:
    app: __OCBuildName__
    environment: __environment__
  name: eam-integration
  namespace: __OCProjectName__
spec:
  ports:
    - name: 8095-tcp
      port: 8095
      protocol: TCP
      targetPort: 8095
  selector:
    app: __OCBuildName__
  sessionAffinity: None
  type: ClusterIP
status:
  loadBalancer: {}