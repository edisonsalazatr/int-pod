apiVersion: v1
kind: Service
metadata:
  labels:
    app: __OCBuildName__
    environment: __environment__
  name: dss-worker
  namespace: __OCProjectName__
spec:
  ports:
    - name: 8100-tcp
      port: 8100
      protocol: TCP
      targetPort: 8100
  selector:
    app: __OCBuildName__
  sessionAffinity: None
  type: ClusterIP
status:
  loadBalancer: {}