                    "entityUuidMethodName": "getProcessId",
                    "entityConcurrency": "1",
                    "entityNumberOfPartition": "1",
                    "entityNumberOfReplicas": "1",
                    "entityNumberRetry": "__topicDssForwardOdLRetry__"
                },                
                "dssEventHiCalcHandler": {
                    "entityName": "topic-mas-handle-hi-calc__kafkaTopicSuffix__",
                    "entityType": "TOPIC",
                    "entityDescription": "KAFKA Topic for calculate hi",
