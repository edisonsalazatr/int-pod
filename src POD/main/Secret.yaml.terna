apiVersion: v1
kind: Secret
data:
  osb-basicauth-username: __osb-eam-username__
  osb-basicauth-password: __osb-eam-password__
  eam-client-id: __eam-client-id__
  eam-client-id-osb: __eam-client-id-osb__
  eam-client-secret: __eam-client-secret__
  eam-client-secret-osb: __eam-client-secret-osb__
  elive-client-id: __elive-client-id__
  cavi-client-id: __cavi-client-id__
  geocall-client-id: __geocall-client-id__
  agile-client-id: __agile-client-id__
  sisnet-client-id: __sisnet-client-id__
  sap-client-id: __sap-client-id__
  tagetik-client-id: __tagetik-client-id__
  eam-integration-keystore.jks: __eam-integration-keystore__
  eam-ca-certificate.jks: __eam-ca-certificate__
  eam-database-username: __eam-database-username__
  eam-database-password: __eam-database-password__
  agile-apikey: __agile-apikey__
  cavi-apikey: __cavi-apikey__
  elive-apikey: __elive-apikey__
  geocall-apikey: __geocall-apikey__
  maximo-apikey: __maximo-apikey__
metadata:
  name: eam-integration-secret-credentials
  namespace: __OCProjectName__
type: Opaque
