            }
        }, 
        "cache": {
            "selectedCacheManager": "__selectedCacheManager__",
            "config": {
                "cacheTtlMinutes": __cacheTtlMinutes__,
                "cacheMaxSize": __cacheMaxSize__,
                "cacheHostName": "__cacheHostName__",
                "cacheHostPort": "__cacheHostPort__",
                "cacheHostUsername": "__cacheHostUsername__",
                "cacheHostPassword": "__cacheHostPassword__"
             }
        },        
        "http" : {
            "settings": {
                "maximumConnectionPerRoute": "__httpMaximumConnectionPerRoute__",
                "maximumConnectionTotal": "__httpMaximumConnectionTotal__",
                "connectionTimeout" : "__httpConnectionTimeout__",
                "validateAfterInactivity" : "__httpValidateAfterInactivity__",
                "idleConnectionMonitorDelay" : "__httpIdleConnectionMonitorDelay__",
                "securityByPass": false
            }
        },
        "executorThreadPool" : __threadPoolParallelism__,
        "executorSendKafkaAssetNumThreadPool": __threadSendKafkaAssetNum__,
        "executorTroncoThreadPool": __troncoThreadPoolParallelism__,
        "bypassBusinessLogic": __bypassBusinessLogic__,
        "bypassEventManagerBusinessLogic": __bypassEventManagerBusinessLogic__,
        "disableIntegration": __disableIntegration__,
        "disableHiCalc": __disableHiCalc__,
        "archiveDayDelay" : __archiveDayDelay__,
        "archiveDeleteBatchSize" : __archiveDeleteBatchSize__,
        "archiveScheduleCron": "__archiveScheduleCron__"
    }
