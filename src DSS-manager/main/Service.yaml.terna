apiVersion: v1
kind: Service
metadata:
  labels:
    app: __OCBuildName__
    environment: __environment__
  name: dss-manager
  namespace: __OCProjectName__
spec:
  ports:
    - name: 8101-tcp
      port: 8101
      protocol: TCP
      targetPort: 8101
  selector:
    app: __OCBuildName__
  sessionAffinity: None
  type: ClusterIP
status:
  loadBalancer: {}